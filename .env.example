# Copy the values you need into a private environment file. Never commit it.
CC_WEB_HOST=127.0.0.1
CC_WEB_PORT=8000
CC_WEB_AUTH=1
CC_WEB_TOKEN=replace-with-a-long-random-token
CC_WEB_ROOTS=/home/your-user/projects
CC_WEB_DEFAULT_DIR=/home/your-user/projects
CC_WEB_DISK_ROOTS=/home/your-user/projects

# Optional executable overrides:
# CC_WEB_CLAUDE=/home/your-user/.local/bin/claude
# CC_WEB_CODEX=/home/your-user/.local/bin/codex
# CC_WEB_OPENCODE=/home/your-user/.opencode/bin/opencode

# Optional private state paths (keep these outside the checkout):
# CC_WEB_AGENT_RUNTIME_DIR=/home/your-user/.cache/cc-web-terminal/sessions
# CC_WEB_AGENT_UPDATE_DIR=/home/your-user/.cache/cc-web-terminal/updates
# CC_WEB_WORKSPACE_DB=/home/your-user/.cache/cc-web-workspaces/state.sqlite3
# CC_WEB_TERMINAL_LAUNCHER_DIR=/home/your-user/.cache/cc-web-terminal/bin

# Codex defaults to inline history; set 0 only to opt into fullscreen mode.
# CC_WEB_CODEX_SCROLLBACK=1
